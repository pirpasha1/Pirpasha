# Copy to .env (or set these in your service manager) — all are optional.
PORT=3000
HOST=0.0.0.0
# Where the SQLite database, uploaded photos and the session secret are stored.
DATA_DIR=./data
# At least 32 random characters. If unset, one is generated and stored in DATA_DIR/.jwt-secret
JWT_SECRET=
# Initial staff accounts (only used the first time the database is created).
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@123
KITCHEN_USERNAME=kitchen
KITCHEN_PASSWORD=Kitchen@123
# Set to true when serving over HTTPS (cookies become Secure).
COOKIE_SECURE=false
# Set to true when running behind nginx / a load balancer.
TRUST_PROXY=false
