{
  "name": "restaurant-ordering-system",
  "version": "1.0.0",
  "description": "Restaurant digital ordering system: QR table ordering, kitchen display, admin dashboard and PDF bills",
  "main": "server.js",
  "scripts": {
    "start": "node --env-file-if-exists=.env server.js",
    "dev": "node --env-file-if-exists=.env --watch server.js",
    "test": "node --test test/api.test.js",
    "test:ui": "node test/ui.test.js",
    "images": "node scripts/generate-dish-images.js"
  },
  "license": "MIT",
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^13.2.0",
    "cookie-parser": "^1.4.7",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.4",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.3",
    "multer": "^2.5.0",
    "pdfkit": "^0.20.2",
    "qrcode": "^1.5.4"
  },
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "devDependencies": {
    "playwright": "^1.63.0"
  }
}
