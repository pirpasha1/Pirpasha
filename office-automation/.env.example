# Copy this file to ".env" and fill in your own values.
# Find them in Supabase: Project Settings -> API (or "Data API" / "API Keys").
#
# The anon / publishable key is SAFE to use in the browser: the database
# security rules (Row Level Security) protect your data.
# NEVER put the "service_role" / secret key in this file.

VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-or-publishable-key

# Set to "false" to hide the "Create an account" option on the sign-in screen
# (then only an administrator can add users from the Supabase dashboard).
VITE_ALLOW_SIGNUP=true
